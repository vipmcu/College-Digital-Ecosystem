# ── Core ──────────────────────────────────────────
NODE_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/college_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Auth / NextAuth.js ────────────────────────────
NEXTAUTH_SECRET=change-me-to-a-secure-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-secure-secret-at-least-32-chars

# ── Local File Storage ───────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET_DOCUMENTS=./uploads/documents
STORAGE_BUCKET_EXPORTS=./uploads/exports

# ── Message Queue (RabbitMQ) ──────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Observability (Native Dashboard) ─────────────
METRICS_ENABLED=true
METRICS_REFRESH_INTERVAL_MS=5000
