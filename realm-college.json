      },
      {
        "name": "registrar",
        "description": "Registrar Staff Role"
      },
      {
        "name": "document_officer",
        "description": "Document & Archive Officer Role"
      },
      {
        "name": "executive",
        "description": "Executive & Dean Role"
      },
      {
        "name": "it_admin",
        "description": "IT Administrator Role"
      },
      {
        "name": "dpo",
        "description": "Data Protection Officer Role"
      }
